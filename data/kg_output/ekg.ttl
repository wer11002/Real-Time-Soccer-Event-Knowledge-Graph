@prefix data: <http://soccerekg.org/data#> .
@prefix ekg: <http://soccerekg.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

data:event_0009 a ekg:ActionEvent ;
    ekg:IN_MATCH data:match_2019_10_01_blackburn_rovers_nottingham_forest ;
    ekg:PRECEDED_BY data:event_0008 ;
    ekg:hasConfidence 3.335e-01 ;
    ekg:hasEventType "Goal" ;
    ekg:hasTime "1st 12:00" ;
    ekg:hasTimeMin 0e+00 ;
    ekg:isMatched false .

data:player_adam_armstrong a ekg:Player ;
    rdfs:label "Adam Armstrong" ;
    ekg:PARTICIPATED_IN data:match_2019_10_01_blackburn_rovers_nottingham_forest ;
    ekg:PERFORMED data:event_0005,
        data:event_0006 ;
    ekg:PLAYS_FOR data:team_blackburn_rovers .

ekg:ASSISTED_BY a owl:ObjectProperty ;
    rdfs:label "ASSISTED_BY" ;
    rdfs:domain ekg:Event ;
    rdfs:range ekg:Player .

ekg:INVOLVED_IN a owl:ObjectProperty ;
    rdfs:label "INVOLVED_IN" ;
    rdfs:domain ekg:Team ;
    rdfs:range ekg:Event .

ekg:IN_MATCH a owl:ObjectProperty ;
    rdfs:label "IN_MATCH" ;
    rdfs:domain ekg:Event ;
    rdfs:range ekg:Match .

ekg:PARTICIPATED_IN a owl:ObjectProperty ;
    rdfs:label "PARTICIPATED_IN" ;
    rdfs:domain ekg:Player ;
    rdfs:range ekg:Match .

ekg:PERFORMED a owl:ObjectProperty ;
    rdfs:label "PERFORMED" ;
    rdfs:domain ekg:Player ;
    rdfs:range ekg:Event .

ekg:PLAYS_FOR a owl:ObjectProperty ;
    rdfs:label "PLAYS_FOR" ;
    rdfs:domain ekg:Player ;
    rdfs:range ekg:Team .

ekg:PRECEDED_BY a owl:ObjectProperty ;
    rdfs:label "PRECEDED_BY" ;
    rdfs:domain ekg:Event ;
    rdfs:range ekg:Event .

ekg:TRIGGERED a owl:ObjectProperty ;
    rdfs:label "TRIGGERED" ;
    rdfs:domain ekg:ActionEvent ;
    rdfs:range ekg:CardEvent .

ekg:hasConfidence a owl:DatatypeProperty ;
    rdfs:label "hasConfidence" ;
    rdfs:range xsd:float .

ekg:hasDate a owl:DatatypeProperty ;
    rdfs:label "hasDate" ;
    rdfs:range xsd:string .

ekg:hasEventType a owl:DatatypeProperty ;
    rdfs:label "hasEventType" ;
    rdfs:range xsd:string .

ekg:hasFullText a owl:DatatypeProperty ;
    rdfs:label "hasFullText" ;
    rdfs:range xsd:string .

ekg:hasTime a owl:DatatypeProperty ;
    rdfs:label "hasTime" ;
    rdfs:range xsd:string .

ekg:hasTimeMin a owl:DatatypeProperty ;
    rdfs:label "hasTimeMin" ;
    rdfs:range xsd:float .

ekg:isMatched a owl:DatatypeProperty ;
    rdfs:label "isMatched" ;
    rdfs:range xsd:boolean .

data:event_0001 a ekg:ActionEvent ;
    ekg:IN_MATCH data:match_2019_10_01_blackburn_rovers_nottingham_forest ;
