data:event_0008 a ekg:ActionEvent ;
    ekg:IN_MATCH data:match_2019_10_01_blackburn_rovers_nottingham_forest ;
    ekg:PRECEDED_BY data:event_0007 ;
    ekg:hasConfidence 6.345e-01 ;
    ekg:hasEventType "Goal" ;
