ekg:CardEvent a owl:Class ;
    rdfs:label "CardEvent" ;
    rdfs:subClassOf ekg:Event .

data:event_0005 a ekg:ActionEvent ;
    ekg:IN_MATCH data:match_2019_10_01_blackburn_rovers_nottingham_forest ;
    ekg:PRECEDED_BY data:event_0004 ;
    ekg:hasConfidence 4.539e-01 ;
    ekg:hasEventType "Goal" ;
    ekg:hasFullText "Attempt saved. Adam Armstrong (Blackburn Rovers) right footed shot from outside the box is saved in the centre of the goal. Assisted by Stewart Downing." ;
    ekg:hasTime "1st 07:30" ;
    ekg:hasTimeMin 0e+00 ;
    ekg:isMatched true .

data:event_0006 a ekg:ActionEvent ;
    ekg:IN_MATCH data:match_2019_10_01_blackburn_rovers_nottingham_forest ;
    ekg:PRECEDED_BY data:event_0005 ;
    ekg:hasConfidence 2.332e-01 ;
    ekg:hasEventType "Goal" ;
    ekg:hasFullText "Attempt saved. Adam Armstrong (Blackburn Rovers) right footed shot from outside the box is saved in the centre of the goal. Assisted by Stewart Downing." ;
    ekg:hasTime "1st 09:30" ;
    ekg:hasTimeMin 0e+00 ;
    ekg:isMatched true .

ekg:Match a owl:Class ;
    rdfs:label "Match" .

ekg:Team a owl:Class ;
    rdfs:label "Team" .

ekg:Player a owl:Class ;
    rdfs:label "Player" .

ekg:Event a owl:Class ;
    rdfs:label "Event" .

data:match_2019_10_01_blackburn_rovers_nottingham_forest a ekg:Match ;
    rdfs:label "2019-10-01 - Blackburn Rovers - Nottingham Forest" ;
    ekg:hasDate "2019-10-01" .

ekg:ActionEvent a owl:Class ;
    rdfs:label "ActionEvent" ;
    rdfs:subClassOf ekg:Event .

